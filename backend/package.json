{
  "name": "popular-hospital-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "$pkg = (Split-Path $env:npm_package_json -Parent) -replace '^\\\\\\\\\\?\\\\', ''; Set-Location $pkg; node (Join-Path $pkg 'src/index.js')",
    "build": "echo \"No backend build step required\"",
    "start": "$pkg = (Split-Path $env:npm_package_json -Parent) -replace '^\\\\\\\\\\?\\\\', ''; Set-Location $pkg; node (Join-Path $pkg 'src/index.js')",
    "db:seed": "$pkg = (Split-Path $env:npm_package_json -Parent) -replace '^\\\\\\\\\\?\\\\', ''; Set-Location $pkg; node (Join-Path $pkg 'src/seed.js')"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.0",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.4"
  }
}
